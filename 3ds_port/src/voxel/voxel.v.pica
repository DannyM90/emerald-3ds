; Voxel terrain vertex shader.
;
; position + shade packed as four shorts, texcoord as two floats (16 bytes, see
; VoxelGpuVertex in ctr_voxel.c). Positions are in 1/512 tile relative to the
; draw's origin; shade is 1/16384. The origin is added here, in whole tiles
; from an anchor near the camera that modelView carries: a shared edge of two
; chunks then reaches the matrix as the same numbers, exactly. Folded into each
; chunk's own modelView, it was rounded differently on either side and the seam
; opened a row of background pixels as the camera moved. Optional fixed-sun
; lighting is baked on the CPU into shade.
;
; Per vertex, the shader turns that brightness into a colour grade and a haze
; weight (see VoxelGrade in ctr_voxel.c):
;   t      = clamp(shade * grade.x + grade.y, 0, 1)   how sunlit the vertex is
;   colour = shade * (shadeTint + tintDiff * t)       cool in shadow, warm in sun
;   haze   = clamp(-viewZ * fog.x + fog.y, 0, fog.z)  further is hazier
; The colour carries half its value: the texture environment doubles it, so
; sun can brighten a texel instead of only ever darkening it. The haze weight
; goes out as 1 - haze in alpha, which the haze environment uses to mix
; towards the haze colour; texture alpha alone decides transparency.
;
; texcoord1 places the sun dapples (see DappleUniforms in ctr_voxel.c): the
; position, slid along the sun by its height, rotated and scaled into the
; pattern, which the world and sprites sample (and the rays, turned).
;   dapple = (dappleU . position, dappleV . position)
;
; SHADOW QUALITY HIGH samples the sun's shadow map on texture unit 0, the only
; unit that reads one (see "Shadow map" in ctr_voxel.c). Its coordinates come
; from the view-space position, the same for every draw of an eye:
;   shadow = (shadowU . view, shadowV . view, w = shadowW . view)
; and shadowSel moves the texture's own coordinates: x is how much of them
; texcoord0 keeps, y how much texcoord1 takes (0, 1 with the map, the atlas
; then on unit 1; 1, 0 without it, the shadow uniforms all 0).
; Drawing the map itself, z and w set how much further from the sun a lit
; vertex is put - z the most, in clip depth, w the ambient shade from which
; it starts (it is all there 1/50 above):
;   depth += shadowSel.z * clamp((shade - shadowSel.w) * 50, 0, 1)
; so a lit surface does not shadow itself, while one the sun does not reach -
; which the map cannot change, and where the sun's ray enters what shades the
; ground - stays where it is and the shadow keeps to the foot of its caster.
;
; A vertex whose shade is negative is one the wind moves - the top of a tuft
; of grass, of a flower (voxel_tree.c): it is displaced by `wind`, this
; frame's sway in tiles, and lit by the shade without its sign.
;
; A shade of 1.5 or more is water's (voxel_mesh_builder.h, VOXEL_WATER_*): the
; real shade, 0-1, is packed into 0.24 above 1.5 for the sea and above 1.75
; for still water. Two trains of waves cross it as light - a triangle wave of
; the position along waveA and of it along waveB, each with its phase for the
; frame and the draw's origin in w - and it is lit a little brighter:
;   shade *= 1 + glow + amplitude * (waveA + waveB - 0.5)
; The surface itself stays flush with its shores: moved, it would open them.

.fvec projection[4], modelView[4], origin
.fvec shadeTint, tintDiff, grade, fog
.fvec dappleU, dappleV
.fvec wind
.fvec waveA, waveB, waveGain
.fvec shadowU, shadowV, shadowW, shadowSel

; x: position scale, y: shade scale, z: 0, w: 1
.constf ctrVoxelConst(0.001953125, 0.00006103515625, 0.0, 1.0)
.constf ctrShadowConst(50.0, 0.0, 0.0, 0.0)
.alias  ones  ctrVoxelConst.wwww
.alias  zeros ctrVoxelConst.zzzz
; x: water from this shade, y: still water from this one (over the sea's
; brightest, 1.74, and under still water's darkest, 1.75), z: the sea's base,
; w: still water's base over the sea's
.constf ctrWaterConst(1.45, 1.745, 1.5, 0.25)
; x: 1 / 0.24 - 1, y: 0.5, z: -0.5
.constf ctrWaterScale(3.1666667, 0.5, -0.5, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc0w texcoord0w
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0 ; x, y, z, shade
.alias intex v1 ; u, v

.proc main
	mul r0.xyz, ctrVoxelConst.xxxx, inpos
	mov r0.w,   ones

	; r8 = 1 where the shade is negative; the wind moves those
	slt r8, inpos.wwww, zeros
	mul r9, wind, r8
	add r0.xyz, r0, r9

	; r7 = position from the anchor (origin.w is 0)
	add r7, origin, r0

	; r1 = modelView * r7
	dp4 r1.x, modelView[0], r7
	dp4 r1.y, modelView[1], r7
	dp4 r1.z, modelView[2], r7
	dp4 r1.w, modelView[3], r7

	; r2 = shade (its sign is the wind's, its range water's)
	mul r9, ctrVoxelConst.yyyy, inpos.wwww
	max r2, r9, -r9

	; r12 = 1 on water, r13 = 1 on still water; r2 = the shade they carry
	sge r12, r2, ctrWaterConst.xxxx
	sge r13, r2, ctrWaterConst.yyyy
	mul r14, ctrWaterConst.zzzz, r12
	add r2, r2, -r14
	mul r14, ctrWaterConst.wwww, r13
	add r2, r2, -r14
	mul r14, ctrWaterScale.xxxx, r12
	add r14, ones, r14
	mul r2, r2, r14

	; r11 = the two waves' sum, 0-1, less a half
	mov r10, zeros
	dp4 r10.x, waveA, r0
	dp4 r10.y, waveB, r0
	flr r11, r10
	add r10, r10, -r11
	add r10, ctrWaterScale.zzzz, r10
	max r11, r10, -r10
	add r11, r11.xxxx, r11.yyyy
	add r11, ctrWaterScale.zzzz, r11

	; shade *= 1 + glow + amplitude * r11, on water alone
	mul r14, waveGain.yyyy, r12
	mul r15, waveGain.zzzz, r13
	add r14, r14, r15
	mul r14, r14, r11
	mul r15, waveGain.xxxx, r12
	add r14, r14, r15
	add r14, ones, r14
	mul r2, r2, r14

	; outpos = projection * r1, a lit vertex put back in the map's pass
	dp4 r10.x, projection[0], r1
	dp4 r10.y, projection[1], r1
	dp4 r10.z, projection[2], r1
	dp4 r10.w, projection[3], r1
	add r11, -shadowSel.wwww, r2
	mul r11, ctrShadowConst.xxxx, r11
	max r11, zeros, r11
	min r11, ones, r11
	mul r11, shadowSel.zzzz, r11
	add r10.z, r10.z, -r11.x
	mov outpos, r10

	mov outtc2, intex

	; r8 = the shadow map's coordinates (+ the atlas', without the map)
	mov r8, zeros
	dp4 r8.x, shadowU, r1
	dp4 r8.y, shadowV, r1
	mul r9, shadowSel.xxxx, intex
	add r8, r8, r9
	mov outtc0, r8

	; texcoord0w = the map's depth
	dp4 r9.x, shadowW, r1
	mov outtc0w, r9.xxxx

	; r6 = the dapple pattern's coordinates (+ the atlas', with the map)
	mov r6, zeros
	dp4 r6.x, dappleU, r0
	dp4 r6.y, dappleV, r0
	mul r9, shadowSel.yyyy, intex
	add r6, r6, r9
	mov outtc1, r6

	; r3 = t
	mul r3, grade.xxxx, r2
	add r3, grade.yyyy, r3
	max r3, zeros, r3
	min r3, ones, r3

	; r4 = shade * lerp(shadeTint, sunTint, t)
	mul r4, tintDiff, r3
	add r4, shadeTint, r4
	mul r4, r2, r4
	mov outclr.xyz, r4

	; r5 = haze from view-space depth (the camera looks down -Z)
	mul r5, fog.xxxx, r1.zzzz
	add r5, fog.yyyy, r5
	max r5, zeros, r5
	min r5, fog.zzzz, r5
	add outclr.w, ones, -r5

	end
.end

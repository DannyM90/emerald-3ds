+#ifdef PLATFORM_3DS
+// 3ds_bottom_ui.c: YES or NO tapped on the bottom screen (0, 1), -1 for none.
+s8 CtrBattleMenu_YesNoInput(void);
+
+// A YES/NO box waiting: the bottom screen offers its two answers and says
+// which was tapped; the cursor goes there and A takes it, as pressed.
+static void CtrBattle_YesNoTap(void)
+{
+    s8 tap = CtrBattleMenu_YesNoInput();
+
+    if (tap < 0)
+        return;
+    if (gBattleCommunication[CURSOR_POSITION] != tap)
+    {
+        BattleDestroyYesNoCursorAt(gBattleCommunication[CURSOR_POSITION]);
+        gBattleCommunication[CURSOR_POSITION] = tap;
+        BattleCreateYesNoCursorAt(tap);
+    }
+    gMain.newKeys |= A_BUTTON;
+}
+#endif
+
 static void Cmd_yesnoboxlearnmove(void)
 {
     gActiveBattler = 0;

Pokémon Emerald 3Ds Dual Screen changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: The Japanese title screen's palettes and banner
Applies after 0005-port-hooks.patch; apply with tools/bootstrap.py.

diff --git a/src/title_screen.c b/src/title_screen.c
--- a/src/title_screen.c
+++ b/src/title_screen.c
@@ -47,7 +47,18 @@
 #define VERSION_BANNER_LEFT_X (98 + TITLE_CENTER_X_OFFSET)
 #define VERSION_BANNER_RIGHT_X (162 + TITLE_CENTER_X_OFFSET)
 #define VERSION_BANNER_Y 2
+#if defined(PORT_BRIDGE) && GAME_LANGUAGE == LANGUAGE_JAPANESE
+// The Japanese title screen, as the Japanese game sets it up: its logo is
+// shorter (the banner stops higher), the background has 9 palettes, the
+// sixth of them (Rayquaza and the clouds) also goes to palette 14, and the
+// 8bpp version banner is drawn with the same 9 palettes.
+#define JAPANESE_TITLE_SCREEN
+#define VERSION_BANNER_Y_GOAL 48
+#define TITLE_BG_PALETTES 9
+#define TITLE_RAYQUAZA_PALETTE 5
+#else
 #define VERSION_BANNER_Y_GOAL 66
+#endif
 #define START_BANNER_X (128 + TITLE_CENTER_X_OFFSET)
 
 #define CLEAR_SAVE_BUTTON_COMBO (B_BUTTON | SELECT_BUTTON | DPAD_UP)
@@ -649,7 +660,12 @@
         // bg2
         LZ77UnCompVram(gTitleScreenPokemonLogoGfx, (void *)(BG_CHAR_ADDR(0)));
         LZ77UnCompVram(gTitleScreenPokemonLogoTilemap, (void *)(BG_SCREEN_ADDR(9)));
+#ifdef JAPANESE_TITLE_SCREEN
+        LoadPalette(gTitleScreenBgPalettes, BG_PLTT_ID(0), TITLE_BG_PALETTES * PLTT_SIZE_4BPP);
+        LoadPalette(&gTitleScreenBgPalettes[TITLE_RAYQUAZA_PALETTE * 16], BG_PLTT_ID(14), PLTT_SIZE_4BPP);
+#else
         LoadPalette(gTitleScreenBgPalettes, BG_PLTT_ID(0), 15 * PLTT_SIZE_4BPP);
+#endif
         // bg3
         LZ77UnCompVram(sTitleScreenRayquazaGfx, (void *)(BG_CHAR_ADDR(2)));
         LZ77UnCompVram(sTitleScreenRayquazaTilemap, (void *)(BG_SCREEN_ADDR(26)));
@@ -667,7 +683,11 @@
         LoadCompressedSpriteSheet(&sSpriteSheet_EmeraldVersion[0]);
         LoadCompressedSpriteSheet(&sSpriteSheet_PressStart[0]);
         LoadCompressedSpriteSheet(&sPokemonLogoShineSpriteSheet[0]);
+#ifdef JAPANESE_TITLE_SCREEN
+        LoadPalette(gTitleScreenBgPalettes, OBJ_PLTT_ID(0), TITLE_BG_PALETTES * PLTT_SIZE_4BPP);
+#else
         LoadPalette(gTitleScreenEmeraldVersionPal, OBJ_PLTT_ID(0), PLTT_SIZE_4BPP);
+#endif
         LoadSpritePalette(&sSpritePalette_PressStart[0]);
         gMain.state = 2;
         break;

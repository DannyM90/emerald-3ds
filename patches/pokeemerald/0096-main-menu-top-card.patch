+#ifdef PLATFORM_3DS
+// The menu with a saved game to continue, from its first highlight until it
+// fades out: the top screen shows that game's trainer card in place of the
+// menu's own windows (3ds_bottom_pass.inc), the entries being the bottom
+// screen's buttons.
+bool8 CtrMainMenu_CardUp(void)
+{
+    u8 taskId = FindTaskIdByFunc(Task_HandleMainMenuInput);
+
+    if (taskId == TASK_NONE)
+        taskId = FindTaskIdByFunc(Task_HighlightSelectedMainMenuItem);
+    if (taskId == TASK_NONE)
+        taskId = FindTaskIdByFunc(Task_HandleMainMenuAPressed);
+    if (taskId == TASK_NONE)
+        taskId = FindTaskIdByFunc(Task_HandleMainMenuBPressed);
+    return taskId != TASK_NONE && gTasks[taskId].tMenuType != HAS_NO_SAVED_GAME;
+}
+#endif
+
 #undef tMenuType
 #undef tCurrItem
 #undef tItemCount

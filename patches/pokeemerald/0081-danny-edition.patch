Applies after 0080-german-layout.patch; apply with tools/bootstrap.py.

diff --git a/data/scripts/pc.inc b/data/scripts/pc.inc
index 1993aaf..7e00284 100644
--- a/data/scripts/pc.inc
+++ b/data/scripts/pc.inc
@@ -64,3 +64,27 @@ EventScript_AccessHallOfFame::
 	waitstate
 	goto EventScript_AccessPC
 	end
+
+@ Emerald 3DS (OPTIONS, EXTRAS): the PC's boxes and the Move Relearner,
+@ opened from the bottom screen in the field (3ds_cheats_plus.inc).
+EventScript_CtrOpenStorage::
+	lockall
+	special ShowPokemonStorageSystemPC
+	waitstate
+	releaseall
+	end
+
+EventScript_CtrMoveRelearner::
+	lockall
+	special ChooseMonForMoveRelearner
+	waitstate
+	goto_if_eq VAR_0x8004, PARTY_NOTHING_CHOSEN, EventScript_CtrMoveRelearnerEnd
+	special IsSelectedMonEgg
+	goto_if_eq VAR_RESULT, TRUE, EventScript_CtrMoveRelearner
+	goto_if_eq VAR_0x8005, 0, EventScript_CtrMoveRelearner
+	special TeachMoveRelearnerMove
+	waitstate
+	goto EventScript_CtrMoveRelearner
+EventScript_CtrMoveRelearnerEnd:
+	releaseall
+	end

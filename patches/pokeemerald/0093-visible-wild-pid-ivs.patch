Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: a visible wild Pokemon gets its IVs with its personality
Applies after 0092-touch-message-ack.patch; apply with tools/bootstrap.py.

diff --git a/src/pokemon.c b/src/pokemon.c
--- a/src/pokemon.c
+++ b/src/pokemon.c
@@ -2256,14 +2256,23 @@
 }
 
 // Visible wild Pokemon (wild_encounter.c) roll their personality when they
-// appear and keep it for the battle, so they get the rolls here.
-u32 ShinyOdds_WildPersonality(void)
+// appear and keep it for the battle, so they get the rolls here. Their IVs
+// come with it, as a wild encounter's do (CreateBoxMon): the personality's
+// low half, its high half, then the two IV words, four calls in a row. A
+// Pokemon caught has the personality and IVs the cartridge could give it.
+u32 ShinyOdds_WildPersonality(u32 *ivs)
 {
-    u32 personality = Random32();
+    u32 personality;
     u32 rolls = ShinyRolls();
 
-    while (ShinyRollAgain(&rolls, personality))
-        personality = Random32();
+    do
+    {
+        personality = Random();
+        personality |= (u32)Random() << 16;
+        *ivs = Random();
+        *ivs |= (u32)Random() << 16;
+    }
+    while (ShinyRollAgain(&rolls, personality));
     return personality;
 }
 #endif
diff --git a/src/wild_encounter.c b/src/wild_encounter.c
--- a/src/wild_encounter.c
+++ b/src/wild_encounter.c
@@ -683,6 +683,7 @@
     u16 species, idle, sparkle;
     s16 x, y;                    /* map coordinates (MAP_OFFSET included) */
     u32 personality;

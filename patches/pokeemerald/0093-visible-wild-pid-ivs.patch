 };
 
 static struct VisibleWild sVisible[VW_MAX];
@@ -853,11 +854,31 @@
                                        TestPlayerAvatarFlags(PLAYER_AVATAR_FLAG_UNDERWATER) != 0);
 }
 
-u32 ShinyOdds_WildPersonality(void); // pokemon.c
+u32 ShinyOdds_WildPersonality(u32 *ivs); // pokemon.c
 
-static u32 VisibleRollPersonality(void)
+static u32 VisibleRollPersonality(u32 *ivs)
 {
-    return ShinyOdds_WildPersonality();
+    return ShinyOdds_WildPersonality(ivs);
+}
+
+/* The IVs rolled with its personality, in CreateBoxMon's order. */
+static void VisibleSetIvs(struct Pokemon *mon, u32 ivs)
+{
+    u8 iv;
+
+    iv = ivs & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_HP_IV, &iv);
+    iv = (ivs >> 5) & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_ATK_IV, &iv);
+    iv = (ivs >> 10) & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_DEF_IV, &iv);
+    iv = (ivs >> 16) & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_SPEED_IV, &iv);
+    iv = (ivs >> 21) & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_SPATK_IV, &iv);
+    iv = (ivs >> 26) & MAX_IV_MASK;
+    SetMonData(mon, MON_DATA_SPDEF_IV, &iv);
+    CalculateMonStats(mon);
 }
 
 /*
@@ -1094,7 +1115,7 @@
         }
         // The species it is shown as is the one met when touched (VisibleStartBattle).
         v->species = WILD_SPECIES(wild->species);
-        v->personality = VisibleRollPersonality();
+        v->personality = VisibleRollPersonality(&v->ivs);
         v->shiny = GET_SHINY_VALUE(VisibleOtId(), v->personality) < SHINY_ODDS;
         v->faceX = 0;
         v->faceY = 1;
@@ -1168,6 +1189,7 @@
 {
     ZeroEnemyPartyMons();
     CreateMon(&gEnemyParty[0], v->species, v->level, USE_RANDOM_IVS, TRUE, v->personality, OT_ID_PLAYER_ID, 0);
+    VisibleSetIvs(&gEnemyParty[0], v->ivs);
     CtrLog_Write(CTR_LOG_GAME, "visible wild: battle with species %u lv %u", v->species, v->level);
     VisibleRemove(v);
     BattleSetup_StartWildBattle();
